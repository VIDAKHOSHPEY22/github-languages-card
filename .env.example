# ============================================
# GitHub Languages Card - Environment Variables
# ============================================

# Server port (default: 3000)
PORT=3000

# GitHub Personal Access Token (OPTIONAL)
# Get one at: https://github.com/settings/tokens
# No permissions required - just click "Generate token"
# This increases your API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Node environment
# development = detailed error messages, no caching
# production = optimized, caching enabled
NODE_ENV=development

# For production deployment (Render, Railway, etc.)
# These are usually auto-set by the hosting platform
# RENDER_EXTERNAL_URL=
# RAILWAY_PUBLIC_DOMAIN=
# CYCLIC_URL=